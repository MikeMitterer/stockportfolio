{
  "name": "stockportfolio-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.14.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "3.1.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
