# Was nicht in den Build-Kontext gehört.
#
# node_modules ist der wichtigste Eintrag: Ohne ihn würde der lokale Ordner
# (samt macOS-Binaries) ins Abbild kopiert und den `npm ci`-Layer entwerten.
node_modules
dist
coverage
.vite
.eslintcache

.git
.idea
.claude
.codex
.agents
.libs

docker/logs
docker/preview
docker/.last-build-tag*
docker/.last_login

# Die lokale .env würde die Adresse aus der Entwicklung ins Abbild backen.
# Gesetzt wird sie beim Start (STOCKINFO_API_URL) oder per --build-arg.
.env
.env.*

_tickets
docs
