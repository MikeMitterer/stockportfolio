{
  "name": "stockportfolio-frontend",
  "version": "0.5.0",
  "private": true,
  "description": "Tolerance-band rebalancing web app für persönliches Portfolio (Excel-Ersatz)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc --project tsconfig.json --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --port 4175",
    "typecheck": "vue-tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --cache",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css,json}\"",
    "test": "cd .. && frontend/node_modules/.bin/vitest run --config frontend/vitest.config.ts",
    "test:watch": "cd .. && frontend/node_modules/.bin/vitest --config frontend/vitest.config.ts",
    "test:coverage": "cd .. && frontend/node_modules/.bin/vitest run --config frontend/vitest.config.ts --coverage",
    "clean": "rm -rf dist coverage .vite .eslintcache tsconfig.tsbuildinfo node_modules/.vite node_modules/.vite-temp"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mmit/ux-foundation": "latest",
    "consola": "^3.4.2",
    "idb": "^8.0.3",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.6",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.1.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "sass": "^1.102.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.10"
  },
  "license": "EUPL-1.2",
  "sourceFiles": [
    "frontend/src",
    "frontend/public",
    "api/src",
    "api/drizzle",
    "api/package.json",
    "api/package-lock.json",
    "api/eslint.config.mjs",
    "api/tsconfig.json",
    "scripts/licenseAssets.ts",
    "frontend/package-lock.json",
    "frontend/eslint.config.mjs",
    "frontend/index.html",
    "frontend/vite.config.ts",
    "frontend/tsconfig.json",
    "LICENSE",
    "LICENSE.de.txt",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "SOURCE.md",
    "README.md",
    "docker/Dockerfile",
    "docker/entrypoint.sh",
    ".dockerignore"
  ]
}
