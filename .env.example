# Basis-URL der StockInfo-API (Kurse, Instrumente, History).
# Liest nur der StockPortfolio-Server; der Browser fragt über /api/stockinfo ab.
# Der Server muss StockInfo unter dieser Adresse erreichen.
STOCKINFO_API_URL=https://stockinfo.int.mikemitterer.at

# Welches StockInfo make dev-up verwendet: local startet StockInfo aus dem
# Nachbar-Repository ../StockInfo, remote verwendet STOCKINFO_API_URL oben.
# Ohne Angabe local.
# DEV_STOCKINFO=local

# Tage ohne Nutzung, bis eine Anmeldung abläuft; jede Nutzung startet die
# Frist neu. Ganze Tage von 1 bis 365, ohne Angabe 7.
# STOCKPORTFOLIO_SESSION_IDLE_DAYS=7
